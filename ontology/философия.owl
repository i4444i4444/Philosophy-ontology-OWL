        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_поздний"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Примеры"/>
        <has_quote>«Рассматривай это как завершенный примитивный язык»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#WIT-04 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#WIT-04">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
