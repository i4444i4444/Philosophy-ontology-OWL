        <represents_characteristic rdf:resource="http://example.org/philosophy#Свобода_и_ответственность"/>
        <has_quote>«Экзистенциализм противостоит той распространённой светской морали, которая желает избавиться от бога с минимальными издержками»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#SAR-08 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#SAR-08">
