        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Сартр"/>
        <has_quote>«существуют две разновидности экзистенциалистов: во-первых, это христианские экзистенциалисты»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#SAR-03 -->

