        <represents_characteristic rdf:resource="http://example.org/philosophy#Логико_лингвистический_анализ"/>
        <has_quote>«В этих словах заключена, мне кажется, особая картина действия человеческого языка»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#WIT-02 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#WIT-02">
