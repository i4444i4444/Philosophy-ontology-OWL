        <represents_characteristic rdf:resource="http://example.org/philosophy#Критика_метафизики"/>
        <has_quote>«Приговор действителен для всей философии ценностей и норм»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#CAR-07 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#CAR-07">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
