        <represents_characteristic rdf:resource="http://example.org/philosophy#Семейное_сходство"/>
        <has_quote>«мы видим сложную сеть подобий, накладывающихся друг на друга и переплетающихся»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#WIT-05 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#WIT-05">
