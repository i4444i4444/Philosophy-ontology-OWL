    <!-- http://example.org/philosophy#Т-01 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#Т-01">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Логико-философский_трактат"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Цель"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_ранний"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Граница_языка"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Философия_как_терапия"/>
        <has_quote>«книга хочет поставить границу мышлению, или скорее не мышлению, а выражению мыслей… все, что лежит по ту сторону границы, будет просто бессмыслицей»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#Т-02 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#Т-02">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Логико-философский_трактат"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_ранний"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Атомарные_факты"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Логико_лингвистический_анализ"/>
        <has_quote>«Мир есть совокупность фактов, а не вещей»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#Т-03 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#Т-03">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Логико-философский_трактат"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_ранний"/>
        <has_quote>«Предложение есть образ действительности»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#Т-04 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#Т-04">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Логико-философский_трактат"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_ранний"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Критика_метафизики"/>
        <has_quote>«Большинство предложений и вопросов, высказанных по поводу философских проблем, не ложны, а бессмысленны»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#Т-05 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#Т-05">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Логико-философский_трактат"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Метод"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_ранний"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Философия_как_терапия"/>
        <has_quote>«Философия не теория, а деятельность»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#Т-06 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#Т-06">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Логико-философский_трактат"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Метод"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_ранний"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Граница_языка"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Философия_как_терапия"/>
        <has_quote>«Что может быть показано, не может быть сказано»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#Т-07 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#Т-07">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Логико-философский_трактат"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_ранний"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Граница_языка"/>
        <has_quote>«Границы моего языка означают границы моего мира»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#Т-08 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#Т-08">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
