        <represents_characteristic rdf:resource="http://example.org/philosophy#Примеры"/>
        <has_quote>«Человек — это прежде всего проект, который переживается субъективно, а не мох, не плесень и не цветная капуста»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#WIT-01 -->

