        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Карнап"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Критика_метафизики"/>
        <has_quote>«мнимые предложения этой области являются полностью бессмысленными»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#CAR-03 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#CAR-03">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Преодоление_метафизики_логическим_анализом_языка"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Метод"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Карнап"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Эмпирическая_опора"/>
        <has_quote>«Если для нового слова не установлен критерий, то предложения, в которых оно встречается, ничего не выражают»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#CAR-04 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#CAR-04">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Преодоление_метафизики_логическим_анализом_языка"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Метод"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Карнап"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Логико_лингвистический_анализ"/>
        <has_quote>«Синтаксис языка указывает, какие сочетания слов допустимы, а какие нет»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#CAR-05 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#CAR-05">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Преодоление_метафизики_логическим_анализом_языка"/>
