        <represents_characteristic rdf:resource="http://example.org/philosophy#Существование_предшествует_сущности"/>
        <has_quote>«человек сначала существует, встречается, появляется в мире, и только потом он определяется»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#SAR-05 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#SAR-05">
