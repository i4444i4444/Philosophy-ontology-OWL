        <represents_characteristic rdf:resource="http://example.org/philosophy#Логико_лингвистический_анализ"/>
        <has_quote>«Значение слова — это его употребление в языке»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#WIT-03 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#WIT-03">
