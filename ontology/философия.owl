        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_поздний"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Философия_как_терапия"/>
        <has_quote>«Нам следует отказаться от всякого объяснения и заменить его только описанием»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#WIT-06 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#WIT-06">
