        <represents_characteristic rdf:resource="http://example.org/philosophy#Примеры"/>
        <has_quote>«Возьмём изготовленный человеческими руками предмет, например, книгу или нож для разрезания бумаги»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#SAR-04 -->

