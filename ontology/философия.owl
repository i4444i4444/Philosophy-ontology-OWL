        <represents_characteristic rdf:resource="http://example.org/philosophy#Свобода_и_ответственность"/>
        <has_quote>«человек осуждён быть свободным»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#SAR-09 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#SAR-09">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
