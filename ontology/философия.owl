        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_поздний"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Значение_через_употребление"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Философия_как_терапия"/>
        <has_quote>«Мы возвращаем слова от метафизического к их повседневномуупотреблению»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#WIT-07 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#WIT-07">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Философские_исследования"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Цель"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Витгенштейн_поздний"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Философия_как_терапия"/>
        <has_quote>«Философия никоим образом не смеет посягать на действительное употребление языка… Философия просто все предъявляет нам, ничего не объясняя и не делая выводов»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#WIT-08 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#WIT-08">
