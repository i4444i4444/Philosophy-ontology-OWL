        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Карнап"/>
        <has_quote>«истоком метафизики был миф»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#CAR-09 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#CAR-09">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Преодоление_метафизики_логическим_анализом_языка"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Карнап"/>
        <has_quote>«наследством мифа выступает… поэзия»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#CAR-10 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#CAR-10">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
