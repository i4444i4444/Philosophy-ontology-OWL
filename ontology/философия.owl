<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/philosophy#"
     xml:base="http://example.org/philosophy"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:philosophy="http://example.org/philosophy#">
    <owl:Ontology rdf:about="http://example.org/philosophy"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/philosophy#characterizes_philosopher -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#characterizes_philosopher">
        <owl:inverseOf rdf:resource="http://example.org/philosophy#is_characterized_by"/>
        <rdfs:label xml:lang="ru">характеризует философа</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#contains_fragment -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#contains_fragment">
        <owl:inverseOf rdf:resource="http://example.org/philosophy#described_in_source"/>
        <rdfs:label xml:lang="ru">содержит фрагмент</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#described_in_source -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#described_in_source">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Source"/>
        <rdfs:label xml:lang="ru">описан в источнике</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#describes_dimension -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#describes_dimension">
        <rdfs:domain rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Dimension"/>
        <rdfs:label xml:lang="ru">описывает измерение</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#has_dimension -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#has_dimension">
        <owl:inverseOf rdf:resource="http://example.org/philosophy#is_dimension_of_characteristic"/>
        <rdfs:domain rdf:resource="http://example.org/philosophy#Characteristic"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Dimension"/>
        <rdfs:label xml:lang="ru">имеет измерение</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#has_fragment -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#has_fragment">
        <owl:inverseOf rdf:resource="http://example.org/philosophy#relates_to_philosopher"/>
        <rdfs:domain rdf:resource="http://example.org/philosophy#Philosopher"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <rdfs:label xml:lang="ru">имеет фрагмент</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#has_position -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#has_position">
        <owl:inverseOf rdf:resource="http://example.org/philosophy#is_position_of"/>
        <rdfs:domain rdf:resource="http://example.org/philosophy#Philosopher"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Philosophical_movement"/>
        <rdfs:label xml:lang="ru">имеет позицию</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#influences -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#influences">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://example.org/philosophy#Philosopher"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Philosopher"/>
        <rdfs:label xml:lang="ru">влияет на</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#is_characterized_by -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#is_characterized_by">
        <rdfs:domain rdf:resource="http://example.org/philosophy#Philosopher"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Characteristic"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/philosophy#has_fragment"/>
            <rdf:Description rdf:about="http://example.org/philosophy#represents_characteristic"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="ru">характеризуется</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#is_dimension_of_characteristic -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#is_dimension_of_characteristic">
        <rdfs:domain rdf:resource="http://example.org/philosophy#Dimension"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Characteristic"/>
        <rdfs:label xml:lang="ru">характеристика измерения</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#is_expressed_in -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#is_expressed_in">
        <owl:inverseOf rdf:resource="http://example.org/philosophy#represents_characteristic"/>
        <rdfs:label xml:lang="ru">выражается в</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#is_historically_related_to -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#is_historically_related_to">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/philosophy#Philosopher"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Philosopher"/>
        <rdfs:label xml:lang="ru">исторически связан с</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#is_position_of -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#is_position_of">
        <rdfs:domain rdf:resource="http://example.org/philosophy#Philosophical_movement"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Philosopher"/>
        <rdfs:label xml:lang="ru">является позицией</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#is_source_for -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#is_source_for">
        <owl:inverseOf rdf:resource="http://example.org/philosophy#is_studied_from_source"/>
        <rdfs:domain rdf:resource="http://example.org/philosophy#Source"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Philosopher"/>
        <rdfs:label xml:lang="ru">источник для</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#is_studied_from_source -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#is_studied_from_source">
        <rdfs:domain rdf:resource="http://example.org/philosophy#Philosopher"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Source"/>
        <rdfs:label xml:lang="ru">изучается по источнику</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#relates_to_philosopher -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#relates_to_philosopher">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="ru">относится к философу</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/philosophy#represents_characteristic -->

    <owl:ObjectProperty rdf:about="http://example.org/philosophy#represents_characteristic">
        <rdfs:domain rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <rdfs:range rdf:resource="http://example.org/philosophy#Characteristic"/>
        <rdfs:label xml:lang="ru">представляет характеристику</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/philosophy#has_quote -->

    <owl:DatatypeProperty rdf:about="http://example.org/philosophy#has_quote">
        <rdfs:label xml:lang="ru">имеет цитату</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/philosophy#Characteristic -->

    <owl:Class rdf:about="http://example.org/philosophy#Characteristic">
        <rdfs:label xml:lang="ru">Характеристика</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/philosophy#Dimension -->

    <owl:Class rdf:about="http://example.org/philosophy#Dimension">
        <rdfs:label xml:lang="ru">Измерение</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/philosophy#Goal_Characteristic -->

    <owl:Class rdf:about="http://example.org/philosophy#Goal_Characteristic">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/philosophy#Characteristic"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/philosophy#has_dimension"/>
                        <owl:hasValue rdf:resource="http://example.org/philosophy#Цель"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://example.org/philosophy#Characteristic"/>
        <rdfs:label xml:lang="ru">Характеристика цели</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/philosophy#Interpretation_fragment -->

    <owl:Class rdf:about="http://example.org/philosophy#Interpretation_fragment">
        <rdfs:label xml:lang="ru">Фрагмент интерпретации</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/philosophy#Method_Characteristic -->

    <owl:Class rdf:about="http://example.org/philosophy#Method_Characteristic">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/philosophy#Characteristic"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/philosophy#has_dimension"/>
                        <owl:hasValue rdf:resource="http://example.org/philosophy#Метод"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://example.org/philosophy#Characteristic"/>
        <rdfs:label xml:lang="ru">Характеристика метода</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/philosophy#Philosopher -->

    <owl:Class rdf:about="http://example.org/philosophy#Philosopher">
        <rdfs:label xml:lang="ru">Философ</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/philosophy#Philosophical_movement -->

    <owl:Class rdf:about="http://example.org/philosophy#Philosophical_movement">
        <rdfs:label xml:lang="ru">Философское направление</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/philosophy#Source -->

    <owl:Class rdf:about="http://example.org/philosophy#Source">
        <rdfs:label xml:lang="ru">Источник</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/philosophy#Style_Characteristic -->

    <owl:Class rdf:about="http://example.org/philosophy#Style_Characteristic">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/philosophy#Characteristic"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/philosophy#has_dimension"/>
                        <owl:hasValue rdf:resource="http://example.org/philosophy#Стиль"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://example.org/philosophy#Characteristic"/>
        <rdfs:label xml:lang="ru">Характеристика стиля</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/philosophy#Subject_Characteristic -->

    <owl:Class rdf:about="http://example.org/philosophy#Subject_Characteristic">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/philosophy#Characteristic"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/philosophy#has_dimension"/>
                        <owl:hasValue rdf:resource="http://example.org/philosophy#Предмет"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://example.org/philosophy#Characteristic"/>
        <rdfs:label xml:lang="ru">Характеристика предмета</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/philosophy#BER-01 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-01">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Критика_абстрактных_идей"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Критика_метафизики"/>
        <has_quote>«я абсолютно отрицаю существование не общих идей, а лишь абстрактных общих идей»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#BER-02 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-02">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Логико_лингвистический_анализ"/>
        <has_quote>«сообщение идей, обозначаемых словами, не составляет, как это обыкновенно предполагается, главной или единственной цели языка»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#BER-03 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-03">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Бытие_как_воспринимаемость"/>
        <has_quote>«Их esse есть percipi, и невозможно, чтобы они имели какое-либо существование вне духов или воспринимающих их мыслящих вещей»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#BER-04 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-04">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Метод"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Эмпирическая_опора"/>
        <has_quote>«идея не может походить ни на что иное, кроме идеи»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#BER-05 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-05">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Метод"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <has_quote>«Вам стоит только вникнуть в свои собственные мысли и испытать таким образом, в состоянии ли вы представить себе возможным, чтобы звук, форма, движение и цвет существовали вне духа»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#BER-06 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-06">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Открытость_к_религии"/>
        <has_quote>«причина идей есть бестелесная деятельная субстанция, или дух»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#BER-07 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-07">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Стиль"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <has_quote>«могут возразить, что, согласно вышеприведенным принципам, все то, что реально и субстанциально в природе, изгоняется из мира и заменяется химерической схемой идей»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#BER-08 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-08">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Метод"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Логико_лингвистический_анализ"/>
        <has_quote>«о таких вещах мы должны мыслить как ученые, а говорить как толпа»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#BER-09 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-09">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <has_quote>«Видимый мной огонь есть не причина боли, испытываемой мной при приближении к нему, но только предостерегающий меня от нее знак»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#BER-10 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-10">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Предмет"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <has_quote>«Покуда мы приписываем немыслящим вещам действительное существование, отличное от их воспринимаемости, для нас не только невозможно познать с очевидностью природу какой-нибудь реальной немыслящей вещи»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#BER-11 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#BER-11">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Трактат_о_принципах_человеческого_знания"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Цель"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Беркли"/>
        <has_quote>«Есть много других преимуществ и для религии, и для наук»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#CAR-01 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#CAR-01">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
        <described_in_source rdf:resource="http://example.org/philosophy#Преодоление_метафизики_логическим_анализом_языка"/>
        <describes_dimension rdf:resource="http://example.org/philosophy#Цель"/>
        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Карнап"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Критика_метафизики"/>
        <has_quote>«мнимые предложения метафизики путем логического анализа языка разоблачаются как псевдопредложения»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#CAR-02 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#CAR-02">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
