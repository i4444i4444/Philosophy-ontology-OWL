        <represents_characteristic rdf:resource="http://example.org/philosophy#Критика_метафизики"/>
        <has_quote>«они служат для выражения чувства жизни»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#CAR-08 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#CAR-08">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
