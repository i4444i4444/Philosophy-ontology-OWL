        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Сартр"/>
        <has_quote>«Я хотел бы выступить здесь в защиту экзистенциализма от ряда упрёков, высказанных в адрес этого учения»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#SAR-02 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#SAR-02">
