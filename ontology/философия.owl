        <relates_to_philosopher rdf:resource="http://example.org/philosophy#Карнап"/>
        <represents_characteristic rdf:resource="http://example.org/philosophy#Примеры"/>
        <has_quote>«Мы выбрали несколько предложений из одного метафизического учения»</has_quote>
    </owl:NamedIndividual>
    


    <!-- http://example.org/philosophy#CAR-06 -->

    <owl:NamedIndividual rdf:about="http://example.org/philosophy#CAR-06">
        <rdf:type rdf:resource="http://example.org/philosophy#Interpretation_fragment"/>
